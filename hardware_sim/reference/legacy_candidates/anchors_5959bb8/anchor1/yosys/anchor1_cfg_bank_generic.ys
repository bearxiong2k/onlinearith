# Generic synthesis for the Anchor 1 cfg active/shadow storage.
# This belongs with added storage in the final accounting, not A_sched_logic.
#
# Usage:
#   mkdir -p build
#   yosys -s yosys/anchor1_cfg_bank_generic.ys

read_verilog -sv rtl/tss_anchor1_cfg_bank.sv
chparam -set K 32 -set START_W 6 -set REM_W 6 tss_anchor1_cfg_bank
hierarchy -check -top tss_anchor1_cfg_bank
proc
opt
fsm
opt
memory
opt
techmap
opt
abc
opt_clean -purge
tee -o build/anchor1_cfg_bank_generic_stat.rpt stat
write_json build/anchor1_cfg_bank_generic.json
write_verilog -noattr build/anchor1_cfg_bank_generic_netlist.v
