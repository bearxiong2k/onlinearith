# Liberty-mapped synthesis for the pure Anchor 1 builder logic.
# Replace __LIBERTY_PATH__ with your local .lib path before running.
#
# Usage:
#   mkdir -p build
#   sed 's|__LIBERTY_PATH__|/path/to/tech.lib|g' yosys/anchor1_window_builder_mapped.ys | yosys -s -

read_liberty -lib __LIBERTY_PATH__
read_verilog -sv rtl/tss_anchor1_window_builder.sv
chparam -set K 32 -set D_W 6 -set LAMBDA_W 4 -set H_W 6 -set START_W 6 -set REM_W 6 tss_anchor1_window_builder
hierarchy -check -top tss_anchor1_window_builder
proc
opt
fsm
opt
memory
opt
techmap
opt
dfflibmap -liberty __LIBERTY_PATH__
abc -liberty __LIBERTY_PATH__
opt_clean -purge
tee -o build/anchor1_window_builder_mapped_stat.rpt stat -liberty __LIBERTY_PATH__
write_verilog -noattr build/anchor1_window_builder_mapped_netlist.v
